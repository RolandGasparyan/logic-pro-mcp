  "mastering_chain": {
    "universal_order": [
      { "step": 1, "process": "high_pass_filter",   "params": "20-30 Hz (classical: 30-40 Hz gentle)" },
      { "step": 2, "process": "corrective_eq",      "params": "narrow cuts only, <=3 dB single point" },
      { "step": 3, "process": "dynamic_eq_mbc",     "params": "genre-dependent" },
      { "step": 4, "process": "broadband_comp",     "params": "1-3 dB GR (bypass: classical, jazz)" },
      { "step": 5, "process": "stereo_imaging",     "params": "mono <100-120 Hz, M/S width" },
      { "step": 6, "process": "tonal_eq",          "params": "broad shelves, +/-1-2 dB" },
      { "step": 7, "process": "saturation_exciter","params": "0.3-1 dB (genre dependent)" },
      { "step": 8, "process": "limiter_maximizer","params": "target LUFS, TP ceiling" },
      { "step": 9, "process": "dither",           "params": "24->16 bit, final" }
    ],
    "per_genre_deltas": [
      { "family": "pop",        "hpf": "25 Hz",       "mbc": "3-band light",    "bus_comp": "1-2 dB", "width": "+10% M/S",  "sat": "0.5 dB",  "limiter_gr": "4-6 dB" },
      { "family": "rock",       "hpf": "30 Hz",       "mbc": "3-band guitars",  "bus_comp": "1-2 dB", "width": "neutral",   "sat": "0.5 dB",  "limiter_gr": "4-6 dB" },
      { "family": "hiphop",      "hpf": "25 Hz",       "mbc": "sub-only",        "bus_comp": "bypass", "width": "mono sub",  "sat": "1 dB",    "limiter_gr": "5-7 dB" },
      { "family": "rnb",        "hpf": "30 Hz",       "mbc": "light",          "bus_comp": "1 dB",   "width": "+5%",      "sat": "0.3 dB",  "limiter_gr": "3-5 dB" },
      { "family": "electronic",  "hpf": "25 Hz",       "mbc": "sub+low-mid",    "bus_comp": "bypass", "width": "mono<100",  "sat": "1 dB",    "limiter_gr": "5-7 dB" },
      { "family": "acoustic",    "hpf": "35 Hz",       "mbc": "bypass",         "bus_comp": "bypass", "width": "neutral",   "sat": "0 dB",    "limiter_gr": "2-3 dB" },
      { "family": "classical",   "hpf": "30 Hz gentle","mbc": "bypass",        "bus_comp": "bypass", "width": "neutral",   "sat": "0 dB",    "limiter_gr": "0-1 dB" },
      { "family": "latin",       "hpf": "30 Hz",       "mbc": "light",          "bus_comp": "1 dB",   "width": "+5%",      "sat": "0.5 dB",  "limiter_gr": "4-6 dB" },
      { "family": "ambient",     "hpf": "30 Hz",       "mbc": "bypass",         "bus_comp": "bypass", "width": "wide",     "sat": "tape 1 dB","limiter_gr": "1-3 dB" }
    ]
  },
  "diagnostic_thresholds": {
    "return_to_mix_if": {
      "single_point_corrective_eq_db": 3,
      "cumulative_corrective_eq_db": 6,
      "true_peak_after_limiter_dbtp": -0.5,
      "mono_compatibility_loss_db_100hz": 3,
      "noise_floor_dbfs": -60,
      "source_clipping": "any sample at 0 dBFS"
    },
    "fix_order": ["arrangement", "performance", "recording", "mixing", "mastering"],
    "loudness_warnings": { "plr_min": 5, "plr_max_at_minus9_lufs": 20 }
  },
  "delivery_specs": [
    { "output": "streaming_master", "format": "WAV", "bit_depth": 24, "sample_rate": [44100, 48000], "true_peak_dbtp": -1.0 },
    { "output": "cd_master",        "format": "WAV", "bit_depth": 16, "sample_rate": 44100,         "true_peak_dbfs": -0.3, "dither": true },
    { "output": "vinyl_premaster",  "format": "WAV", "bit_depth": 24, "sample_rate": [44100, 48000], "true_peak_dbtp": -3.0, "mono_bass": true, "min_plr": 10 },
    { "output": "club_dj",          "format": "WAV", "bit_depth": 24, "sample_rate": [44100, 48000], "lufs": [-9, -7], "true_peak_dbtp": -0.5 },
    { "output": "instrumental_tv",  "format": "WAV", "bit_depth": 24, "sample_rate": "session",      "limiter": false },
    { "output": "stems",            "format": "WAV", "bit_depth": 24, "sample_rate": "session",      "headroom_dbfs": -6, "consolidated": true }
  ],
  "qc_checklist": [
    "mono_check_bass_kick_lead_vocal",
    "phase_correlation_positive_low_band",
    "true_peak_measured_not_assumed",
    "lufs_within_genre_range",
    "plr_within_genre_range",
    "no_sample_above_0_dbfs_in_source",
    "level_matched_ab_vs_2_references",
    "dither_applied_once_last",
    "file_naming_convention_applied",
    "metadata_isrc_embedded"
  ]
}
