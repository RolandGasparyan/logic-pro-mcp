    { "id": "soul_funk", "family": "rnb", "master": { "lufs": [-12, -10], "dbtp": -1.0, "plr": [9, 12] }, "sub": "natural bass, no sub", "vocal": "dry, dynamic, no autotune", "width": "horns wide", "signature": "live-feel, minimal grid" },
    { "id": "gospel", "family": "rnb", "master": { "lufs": [-10, -8], "dbtp": -1.0, "plr": [8, 10] }, "sub": "round kick, organ low", "vocal": "choir width, lead cut 2-3 k", "width": "very wide choir", "signature": "choir bus parallel comp" },
