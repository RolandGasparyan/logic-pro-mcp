    { "id": "indie_rock", "family": "rock", "master": { "lufs": [-12, -10], "dbtp": -1.0, "plr": [9, 12] }, "sub": "warm, less sub", "vocal": "natural, room-heavy", "width": "moderate", "signature": "room mics prominent" },
    { "id": "punk", "family": "rock", "master": { "lufs": [-10, -8], "dbtp": -1.0, "plr": [7, 9] }, "sub": "punchy kick", "vocal": "aggressive, fast attack", "width": "wide guitars", "signature": "fast comp, low reverb" },
