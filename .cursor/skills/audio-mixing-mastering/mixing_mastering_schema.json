{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yourdomain.ai/schemas/mixing_mastering_v1.json",
  "title": "Mixing & Mastering Knowledge Base",
  "version": "1.0",
  "description": "Academic-level mixing/mastering reference for AI audio agents",
  "meta": {
    "version": "1.0",
    "units": { "loudness": "LUFS-I", "true_peak": "dBTP", "dynamics": "PLR", "level": "dBFS" }
  },
  "universal_laws": [
    { "id": 1, "name": "gain_staging_first", "rule": "Mix bus peaks -6 dBFS before mastering; per-track peaks -12..-6 dBFS" },
    { "id": 2, "name": "subtract_before_add", "rule": "Corrective EQ -> dynamic control -> creative EQ/saturation" },
    { "id": 3, "name": "level_match_ab", "rule": "Level-match every A/B; >=1 dB louder is perceived as better" },
    { "id": 4, "name": "phase_before_eq", "rule": "Check mono compatibility on every layer; HPF creates phase shift" },
    { "id": 5, "name": "one_problem_one_tool", "rule": "Fix masking with EQ OR panning OR arrangement - not all three" },
    { "id": 6, "name": "reference_matched", "rule": "2-3 commercial refs, level-matched to -14 LUFS" },
    { "id": 7, "name": "master_not_repair", "rule": ">3 dB single-point corrective EQ -> return to mix" },
    { "id": 8, "name": "dither_last", "rule": "Nothing after dither; 24->16 bit only on final render" },
    { "id": 9, "name": "true_peak_ceiling", "rule": "True peak <= -1.0 dBTP (streaming), -3.0 dBTP (vinyl)" },
    { "id": 10, "name": "mono_check_60s", "rule": "Bass, kick, lead vocal must survive mono every 60 s" },
    { "id": 11, "name": "automate_not_static", "rule": "Static faders = flat, lifeless mix" },
    { "id": 12, "name": "genre_dictates_loudness", "rule": "-6 LUFS is not better than -12; it is different" }
  ],
  "frequency_map": [
    { "band": "sub",       "range_hz": [20, 60],     "content": ["808", "kick_fundamental", "sub_bass"], "typical_move": "mono; HPF mix at 20-30 Hz" },
    { "band": "low",       "range_hz": [60, 120],    "content": ["kick_body", "bass", "low_toms"],      "typical_move": "carve 80-100 Hz between kick/bass" },
    { "band": "low_mid",   "range_hz": [120, 350],   "content": ["body", "warmth", "mud"],              "typical_move": "-2..-4 dB narrow cut 200-300 Hz" },
    { "band": "mid",       "range_hz": [350, 2000],  "content": ["fundamental", "intelligibility"],     "typical_move": "presence 800 Hz-1.5 kHz" },
    { "band": "upper_mid", "range_hz": [2000, 5000], "content": ["attack", "clarity", "harshness"],      "typical_move": "watch 2.5-3.5 kHz masking" },
    { "band": "presence",  "range_hz": [5000, 8000], "content": ["consonants", "air"],                   "typical_move": "+1..+3 dB 5-7 kHz vocal" },
    { "band": "air",       "range_hz": [8000, 16000],"content": ["sparkle", "cymbals"],                  "typical_move": "+1..+2 dB shelf" },
    { "band": "ultra",     "range_hz": [16000, 20000],"content": ["ultrasonic_air"],                    "typical_move": "optional low-pass 18-20 kHz" }
  ],
  "masking_priority_order": ["kick_vs_bass", "snare_vs_vocal", "guitars_vs_vocal", "synths_vs_vocal", "reverb_returns"],
  "loudness_standards": [
    { "platform": "spotify_apple_youtube", "normalization_lufs": -14, "target_delivery_lufs": [-14, -9] },
    { "platform": "amazon_music",          "normalization_lufs": -14, "target_delivery_lufs": [-14, -9] },
    { "platform": "tidal",                 "normalization_lufs": -14, "target_delivery_lufs": [-14, -9] },
    { "platform": "ebu_r128_broadcast",    "normalization_lufs": -23, "target_delivery_lufs": [-23.5, -22.5], "true_peak_dbtp": -1.0 },
    { "platform": "club_dj",               "normalization_lufs": null, "target_delivery_lufs": [-9, -7],      "true_peak_dbtp": -0.5 },
    { "platform": "vinyl_cut",             "normalization_lufs": null, "target_delivery_lufs": null,          "true_peak_dbtp": -3.0, "min_plr": 10 }
  ],
